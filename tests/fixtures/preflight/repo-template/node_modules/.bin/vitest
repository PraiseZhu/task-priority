#!/usr/bin/env node
// 测试替身:模拟 vitest run 的输出形状,仅供 sc-preflight 单元测试使用。
// 真实 vitest 的断言失败输出含 AssertionError 与行首 ×;本替身复刻该形状,
// 使 sc-preflight 的 FAILURE_PATTERNS.vitest 判定逻辑得到可重复的测试覆盖。
import fs from 'node:fs';

const args = process.argv.slice(2);
let pathArg = null;
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === 'run') continue;
  if (a === '-t') {
    i++;
    continue;
  }
  // 复刻真实 vitest CLI 的 cosmetic flag 处理（与 sc-preflight 的
  // preflightVitestCosmeticFlags 对齐）：--reporter <name> 与 --reporter=<name> 跳过，
  // 不参与路径解析（真实 vitest 同样如此）。
  if (a === '--reporter') {
    i++;
    continue;
  }
  if (a.startsWith('--reporter=')) continue;
  pathArg = a;
}
if (!pathArg) {
  console.error('FAIL: no test file given');
  process.exit(1);
}

let src;
try {
  src = fs.readFileSync(pathArg, 'utf8');
} catch {
  console.error(`FAIL ${pathArg}`);
  console.error(`Error: Cannot find module '${pathArg}'`);
  process.exit(1);
}

const sleepMs = src.match(/SLEEP_MS=(\d+)/);
if (sleepMs) {
  await new Promise((r) => setTimeout(r, Number(sleepMs[1])));
}

if (src.includes('ASSERT_FAIL')) {
  console.log(`× ${pathArg} > should fail`);
  console.log('AssertionError: expected 1 to be 2');
  console.log('at Object.<anonymous>');
  process.exit(1);
}

if (src.includes('MODULE_NOT_FOUND')) {
  console.log(`FAIL ${pathArg}`);
  console.log("Error: Cannot find module './nope.js'");
  console.log('Failed to load test file');
  process.exit(1);
}

if (src.includes('SIDE_EFFECT_WRITE')) {
  fs.writeFileSync('_side-effect.txt', 'written-by-test\n');
}

process.exit(0);
