#!/usr/bin/env node
// 测试替身:模拟 tsc --noEmit 的输出形状,仅供 sc-preflight 单元测试使用。
// src/ 下含 TS_ERROR_MARK 标记的 .ts 文件 → 输出 error TS2322 并 exit 1;
// 否则 exit 0。真实 tsc 的错误输出含 error TS\d+,本替身复刻该形状。
import fs from 'node:fs';

if (fs.existsSync('src')) {
  for (const f of fs.readdirSync('src')) {
    if (f.endsWith('.ts')) {
      const content = fs.readFileSync(`src/${f}`, 'utf8');
      if (content.includes('TS_ERROR_MARK')) {
        console.log(`src/${f}:3:1 - error TS2322: Type 'string' is not assignable to type 'number'.`);
        process.exit(1);
      }
    }
  }
}
process.exit(0);
